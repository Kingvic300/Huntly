{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.local/share/huntly/documents/**"
        },
        {
          "path": "$APPDATA/huntly/documents/**"
        },
        {
          "path": "$HOME/Library/Application Support/huntly/documents/**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "updater:default",
    "process:allow-restart"
  ]
}
